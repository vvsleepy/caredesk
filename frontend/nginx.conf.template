# Proxy the SPA and forward /api to the backend selected via BACKEND_HOST.
# The file is rendered with envsubst at container start; keep $ vars escaped
# exactly as written so the shell substitutes only BACKEND_HOST.
server {
    listen 8080;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    location /api/ {
        proxy_pass http://${BACKEND_HOST};
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 5s;
        proxy_read_timeout 30s;
    }

    location /api {
        return 307 /api/;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}
